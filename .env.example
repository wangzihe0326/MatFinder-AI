# Server
NODE_ENV=production
PORT=3000
MATFINDER_DB_PATH=matfinder.db

# OpenAI-backed analysis and comparison are optional.
# Leave unset to keep local search/recommendation/database features working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional audit access. Leave empty to keep audit APIs closed while public catalog works.
# Set a long random value only in the backend deployment environment.
MATFINDER_ADMIN_TOKEN=

# Use exactly "render" only when requests reach Node through Render's trusted proxy.
# Leave empty for local Docker or other deployment environments.
MATFINDER_TRUST_PROXY=

# Comma-separated browser origins allowed to call /api/* from another domain.
# Example: https://matfinder-ai.vercel.app
MATFINDER_ALLOWED_ORIGINS=

# Frontend-only deployments can point at a separately deployed backend.
# Example: https://matfinder-api.onrender.com
MATFINDER_API_BASE_URL=
